# 로컬 실행에 필요한 환경 변수 목록이다. 값은 비워 두고 커밋한다.
# 복사해서 .env를 만들고 값을 채운다(.env는 커밋하지 않는다).
# 운영 값은 AWS SSM Parameter Store(/pitchmap/prod/*)에 있다.

# 공공데이터포털 인증키 (고캠핑, 기상청 단기·중기예보, 천문연 출몰시각 공용). Decoding 키를 넣는다.
PUBLICDATA_SERVICE_KEY=

# 카카오맵 JavaScript 키. 이 키는 브라우저에 노출된다. 그래서 카카오 콘솔의 JavaScript SDK 도메인으로 보호한다.
KAKAO_JS_KEY=

# 메일 발송 SMTP (네이버). 비밀번호는 계정 비밀번호가 아니라 애플리케이션 비밀번호다.
MAIL_HOST=smtp.naver.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# 로컬 MySQL. docker compose와 local 프로필 앱이 이 값을 함께 읽는다.
# 개발자가 로컬에서만 쓸 비밀번호를 직접 정해 .env에 넣는다(예시 파일에는 비워 둔다). 운영 값은 Parameter Store에 있다.
DB_NAME=pitchmap
DB_USERNAME=pitchmap
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

# 메일 안의 링크에 쓰는 프론트엔드 주소(비밀값이 아니다). 값을 비워 두면 기본값이 아니라 빈 문자열이 되어 링크가 깨지므로, 로컬 개발용 주소를 채워 둔다.
# 운영에서는 서비스 주소로 바꾼다.
WEB_BASE_URL=http://localhost:5173
