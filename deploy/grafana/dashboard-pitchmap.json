{
  "uid": "pitchmap-overview",
  "title": "피치맵 운영",
  "tags": [
    "pitchmap"
  ],
  "timezone": "Asia/Seoul",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "API",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "처리량 (요청/초)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "전체",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "5xx 오류율",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"pitchmap-app\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[5m])), 1e-9)",
          "legendFormat": "오류율",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "알림 기준: 5분간 5% 이상"
    },
    {
      "type": "timeseries",
      "title": "응답 시간 p50·p95·p99",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "구간 50ms·100ms·200ms·500ms·1s·2s·5s 히스토그램으로 계산한 값이라 구간 사이는 근사값이다"
    },
    {
      "type": "table",
      "title": "엔드포인트별 p95와 처리량 (최근 1시간)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[1h])))",
          "legendFormat": "p95",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"pitchmap-app\",uri!~\"/actuator.*\"}[1h]))",
          "legendFormat": "rps",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "p95 (초)",
              "Value #B": "요청/초"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
