# 운영 서버의 /opt/pitchmap/server.env 형식이다. 비밀값이 아니면서 서버마다 다른 값만 둔다.
# 비밀값(DB 비밀번호, 인증키 등)은 여기에 쓰지 않는다. deploy.sh가 Parameter Store에서 읽는다.
# 개발자가 서버에서 이 파일을 복사해 값을 채우고 권한을 600으로 둔다. 저장소에는 예시만 커밋한다.
# 값에 작은따옴표(')나 줄바꿈을 넣지 않는다. deploy.sh가 값을 작은따옴표로 감싸서 .env에 쓰기 때문이다.

# 서비스 도메인. Caddy 인증서와 메일 링크 주소(https://도메인)에 쓴다.
SITE_ADDRESS=pitchmap.duckdns.org

# DB 이름과 앱 계정. 비밀번호는 Parameter Store에 있다.
DB_NAME=pitchmap
DB_USERNAME=pitchmap

# 네이버 SMTP 로그인 계정이자 발신 주소(예: 아이디@naver.com).
MAIL_USERNAME=

# 공공데이터 파일. 서버의 /opt/pitchmap/data에 둔 파일을 컨테이너 안 경로(/data/...)로 적는다.
# 적재 서비스가 파일 이름 끝의 날짜(_YYYYMMDD)를 기준일로 읽으므로 받은 파일 이름을 바꾸지 않는다.
PUBLICDATA_FOREST_FILE=
PUBLICDATA_PARK_BOUNDARY_FILE=

# Grafana Cloud 전송 주소와 사용자 번호. Grafana Cloud 스택의 Prometheus·Loki 상세 화면에 있다(비밀값이 아니다).
# 전송 토큰은 Parameter Store의 /pitchmap/prod/grafana/token에 있다.
# 예: GRAFANA_PROM_URL=https://prometheus-prod-00-prod-ap-northeast-0.grafana.net/api/prom/push
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
# 예: GRAFANA_LOKI_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=

# DB 백업을 올릴 S3 버킷 이름(비밀값이 아니다). 비워 두면 배포 스크립트가 백업 타이머를 설치하지 않는다.
# 예: BACKUP_BUCKET=pitchmap-backup-123456789012
BACKUP_BUCKET=
